#!/bin/bash
# Runs Codex CLI in an Apptainer container that sees only the current
# directory, an optional second directory, and a persistent per-user home.
#
#   codex [SECOND_DIR] [CODEX ARGS...]
#   codex login --device-auth
set -euo pipefail

SIF="${CODEX_SIF:-/opt/codex/codex.sif}"
CODEX_HOME_HOST="${CODEX_HOME_HOST:-$HOME/codex/codex-home}"

die() { echo "codex: $*" >&2; exit 1; }

# Refuses the home directory, its parents, system folders and shared data roots
check_dir() {
  local d="$1"
  case "$d" in
    /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/media|/mnt|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var|/mnt/data|/mnt/scratch)
      die "refusing to give Codex access to $d (too broad). cd into a project folder first." ;;
  esac
  case "$HOME/" in
    "$d"/*) die "refusing to give Codex access to $d (contains your home directory). cd into a project folder first." ;;
  esac
}

[ -r "$SIF" ] || die "container image $SIF not found or not readable"

mkdir -p "$CODEX_HOME_HOST"
chmod 700 "$CODEX_HOME_HOST"

binds=()
codex_args=()
pwd_in="/home/codex"

case "${1:-}" in
  # Account commands need no project folder
  login|logout|update|--version|-V|--help|-h|help) ;;
  *)
    project="$(realpath -e "$PWD")"
    check_dir "$project"
    binds+=(--bind "$project")
    pwd_in="$project"
    # Writes to the mounted folder(s) without asking; also required for --add-dir
    codex_args+=(--sandbox workspace-write)
    if [ "$#" -gt 0 ] && [[ "$1" != -* ]] && [ -d "$1" ]; then
      second="$(realpath -e "$1")"
      shift
      if [ "$second" != "$project" ]; then
        check_dir "$second"
        binds+=(--bind "$second")
        codex_args+=(--add-dir "$second")
      fi
    fi
    ;;
esac

env_args=(--env "TERM=${TERM:-xterm-256color}")
for v in COLORTERM http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
  [ -n "${!v:-}" ] && env_args+=(--env "$v=${!v}")
done

# Private /tmp for this session, removed on exit
workdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-$USER.XXXXXX")"
trap 'rm -rf "$workdir"' EXIT

# Host mamba installation, mounted at its host path so environments work in both places
mamba_root=""
for d in "${CODEX_MAMBA_ROOT:-}" "${MAMBA_ROOT_PREFIX:-}" "${CONDA_EXE:+$(dirname "$(dirname "$CONDA_EXE")")}" \
         /opt/miniforge3 "$HOME/miniforge3" "$HOME/mambaforge" "$HOME/miniconda3"; do
  if [ -n "$d" ] && [ -x "$d/bin/mamba" ]; then mamba_root="$(realpath -e "$d")"; break; fi
done
if [ -n "$mamba_root" ]; then
  binds+=(--bind "$mamba_root")
  env_args+=(--env "MAMBA_ROOT_PREFIX=$mamba_root")
  # User's environment and package folders: from ~/.condarc (with ~ expanded) plus mamba's defaults
  mamba_dirs=("$HOME/.local/share/mamba/envs" "$HOME/.local/share/mamba/pkgs" "$HOME/.conda/envs" "$HOME/.conda/pkgs")
  if [ -f "$HOME/.condarc" ]; then
    sed "s#~/#$HOME/#g" "$HOME/.condarc" > "$workdir/condarc"
    binds+=(--bind "$workdir/condarc:/opt/codex-config/condarc:ro")
    env_args+=(--env "CONDARC=/opt/codex-config/condarc")
    while IFS= read -r p; do mamba_dirs+=("$p"); done \
      < <(sed -nE 's#^[[:space:]]*-[[:space:]]*(/[^[:space:]#]*).*#\1#p' "$workdir/condarc")
  fi
  declare -A seen=()
  for p in "${mamba_dirs[@]}"; do
    p="${p%/}"
    [ -d "$p" ] && [[ "$p" != "$mamba_root"* ]] && [ -z "${seen[$p]:-}" ] && binds+=(--bind "$p") && seen[$p]=1
  done
fi

umask 002
apptainer run \
  --containall \
  --workdir "$workdir" \
  --home "$CODEX_HOME_HOST:/home/codex" \
  --pwd "$pwd_in" \
  --bind /dev/full \
  "${binds[@]}" \
  "${env_args[@]}" \
  "$SIF" \
  "${codex_args[@]}" "$@" || status=$?

# Codex reports that work continues in a background server; that server ran inside
# the container, which is gone now
if [ -n "${project:-}" ] && [ -t 2 ]; then
  echo "codex: the container has stopped, and with it any running work. To continue a conversation, run 'codex resume' from this folder." >&2
fi
exit "${status:-0}"
