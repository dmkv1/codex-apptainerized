Bootstrap: localimage
From: base.sif

%arguments
    CODEX_VERSION=0.162.1

%labels
    Description Codex CLI with R, Python and bioinformatics tools for lab projects
    CodexVersion {{ CODEX_VERSION }}

%files
    config/AGENTS.md /opt/codex-config/AGENTS.md
    config/sync_agents.py /opt/codex-config/sync_agents.py
    config/mamba /usr/local/bin/mamba

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    export R_LIBS_USER="$HOME/R/library"
    export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$HOME/micromamba}"

%post
    set -eux
    chmod 755 /usr/local/bin/mamba
    touch /opt/codex-config/condarc

    # ============================================
    # Codex CLI and Code Mode host (same release)
    # ============================================
    mkdir -p /opt/codex
    curl -fsSL \
        "https://github.com/openai/codex/releases/download/rust-v{{ CODEX_VERSION }}/codex-package-x86_64-unknown-linux-musl.tar.gz" \
        | tar -xz -C /opt/codex
    ln -sf /opt/codex/bin/codex /usr/local/bin/codex
    ln -sf /opt/codex/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host

%runscript
    # First-run setup of the persistent home
    mkdir -p "$HOME/.codex" "$HOME/R/library"
    [ -f "$HOME/.bashrc" ] || cp /etc/skel/.bashrc "$HOME/.bashrc"
    [ -f "$HOME/.profile" ] || cp /etc/skel/.profile "$HOME/.profile"
    python3 /opt/codex-config/sync_agents.py /opt/codex-config/AGENTS.md "$HOME/.codex/AGENTS.md"
    # Private mount propagation in a nested namespace clears Apptainer's unbindable
    # root, which Codex's bubblewrap sandbox needs to bind-mount
    exec unshare --user --map-current-user --mount --propagation private codex "$@"

%test
    codex --version
    mamba --version
